# Every variable here is OPTIONAL — the app boots with no .env file at all, using the development
# defaults in src/server/environment-schema.ts. Copy this file to .env.development and edit only what
# you need to change.
#
# Production is stricter on purpose: it refuses to start with a placeholder JWT_SECRET or with
# CORS_ORIGINS="true", so "runs out of the box" never becomes "shipped with the sample credentials".

HOST="localhost"                  # default: localhost
PORT=4000                         # default: 4000
CORS_ORIGINS="true"               # "true" (any origin, DEV ONLY) or a comma-separated allow-list

## -----
# DATABASE (PostgreSQL)
# default: postgresql://postgres:postgres@localhost:5432/app?schema=public
DATABASE_URL=""
SKIP_DATABASE_CONNECT=false       # true boots the app without connecting at all

## -----
# AUTH (JWT)
JWT_SECRET="change-this-to-a-long-secret"   # production requires 32+ chars and rejects placeholders
JWT_EXPIRES_IN="7d"               # default: 7d

## -----
# EMAIL (optional, only needed if you enable the mailer integration)
EMAIL_HOST=""
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
